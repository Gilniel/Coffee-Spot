<% layout('layouts/boilerplate') %>

<div id="cluster-map"></div>
<h1>All CoffeeBars</h1>
<div>
    <a href="/coffeebars/new">Add coffeebar</a>
</div>
<% for(let coffeebar of coffeebars) {%>
<div class="card mb-3">
    <div class="row">
        <div class="col-md-4">
            <% if(coffeebar.images.length > 0) {  %>
            <img crossorigin="anonymous" class="img-fluid" alt="" src="<%= coffeebar.images[0].url%>">
            <% } else { %>
            <img crossorigin="anonymous" class="img-fluid" alt=""
                src="https://res.cloudinary.com/dwrjv0ye0/image/upload/v1754515509/ChatGPT_Image_6_ago_2025_05_24_53_p.m._dnvlgy.png">
            <% } %>

        </div>
        <div class="col-md-8">
            <div class="card-body">
                <h5 class="card-title"><%=coffeebar.title%></h5>
                <p class="card-text"><%=coffeebar.description%></p>
                <p class="card-text">
                    <small class="text-muted"> <%=coffeebar.location%></small>
                </p>
                <a href="/coffeebars/<%=coffeebar._id%>" class="btn btn-primary"> Ver <%coffeebar.title %></a>

            </div>
        </div>
    </div>
</div>
<% } %>

<script>
    const mapToken = '<%-process.env.MAPBOX_TOKEN%>';
    const coffeebars = {features: <%- JSON.stringify(coffeebars) %>};
</script>


<script src="/javascripts/clusterMap.js"></script>