<% layout('layouts/boilerplate') %>

<div class="row">
    <div class="col-6 offset-3">
        <div class="card shadow">
    <h1 class="text-center">Edit CoffeeSpot</h1>
    
            <div class="card-body">
                <form action="/coffeebars/<%=coffeebar._id%>?_method=PUT" method="POST" novalidate
                    class="validated-form" enctype="multipart/form-data">

                    <div class="mb-3">
                        <label class="form-label" for="title">Title</label>
                        <input class="form-control" type="text" id="title" name="coffeebar[title]"
                            value="<%=coffeebar.title%>" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="location">Location</label>
                        <input class="form-control" type="text" id="location" name="coffeebar[location]"
                            value="<%=coffeebar.location%>" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="description">Description</label>
                        <textarea class="form-control" type="text" id="description" name="coffeebar[description]"
                            required><%=coffeebar.description%> </textarea>
                    </div>

                    <div class="mb-3">
                        <div class="form-file custom-file">
                            <input type="file" class="form-file-input" id="image" name="image" multiple>
                            <label class="form-file-label" for="image">
                                <span class="form-file-text custom-file-label">Add more image</span>
                                <span class="form-file-button">Browse</span>
                            </label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <% coffeebar.images.forEach( function (img,i ) {   %>
                        <img src="<%= img.thumbnail%>" class="img-thumbnail">
                        <div class="from-check-inline">
                            <input type="checkbox" name="deleteImages[]" id="image-<%= i %>"
                                value="<%= img.filename %>">
                        </div>
                        <label for="image-<%= i %>">>Delete</label>
                        <%})%>
                    </div>

                    <div class="mb-3">
                        <button class="btn btn-info">Update coffeespot</button>
                    </div>

                </form>

                <a href="/coffeebars">All coffeebar</a>
            </div>
        </div>
    </div>
</div>