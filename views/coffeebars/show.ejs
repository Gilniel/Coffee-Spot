<% layout('layouts/boilerplate') %>

<link rel="stylesheet" href="/stylesheets/stars.css">



<div class="row">
    <div class="col-6">
        <div id="coffeebarCarousel" class="carousel slide" data-ride="carousel">
            <div class="carousel-inner">
                <% coffeebar.images.forEach((img, i) => { %>
                <div class="carousel-item <%= i === 0 ? 'active' : ''%>">
                    <img crossorigin="anonymous" src="<%= img.url%>" class="d-block w-100" alt="">
                </div>
                <% }) %>

            </div>
            <% if(coffeebar.images.length > 1) {%>
            <a class="carousel-control-prev" href="#coffeebarCarousel" role="button" data-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="sr-only">Previous</span>
            </a>
            <a class="carousel-control-next" href="#coffeebarCarousel" role="button" data-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="sr-only">Next</span>
            </a>
            <% } %>
        </div>

        <div class="card mb-3">

            <div class="card-body">
                <h5 class="card-title"> <%=coffeebar.title%></h5>
                <p class="card-text"><%=coffeebar.description %></p>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item text-muted"><%= coffeebar.location %></li>
                <li class="list-group-item "> Submitted by: <%= coffeebar.author.username %></li>
                <li class="list-group-item">
                    <span class="text-warning">
                        <% for(let i = 0; i < coffeebar.rate; i++){ %>
                        <i class="bi bi-star-fill"></i>
                        <% } %>
                        <% if(coffeebar.rate % 1 >= 0.5){ %>
                        <i class="bi bi-star-half"></i>
                        <% } %>
                        <% for(let i = Math.ceil(coffeebar.rate); i < 5; i++){ %>
                        <i class="bi bi-star"></i>
                        <% } %>
                </li>
            </ul>

            <% if(currentUser && coffeebar.author.equals(currentUser._id)) {%>
            <div class="card-body">
                <a class="card-link btn btn-info" href="/coffeebars/<%=coffeebar._id %>/edit" class="card-link">Edit</a>
                <form class="d-inline" action="/coffeebars/<%=coffeebar._id %>?_method=delete" method="POST">
                    <button class="card-link btn btn-danger">DELETE</button>
                </form>
            </div>
            <% } %>
            <div class="card-footer text-muted">
                2 days
            </div>
        </div>

    </div>


    <div class="col-6">
        <div id='map' style='width: 400px; height: 300px;'></div>
        <% if(currentUser) {%>
        <h2>Leave a Review</h2>
        <form action="/coffeebars/<%=coffeebar._id%>/reviews" method="POST" class="mb-3 validated-form" novalidate>
            <!-- <div class="mb-3">
                <label class="form-label" for="rating">Rating</label>
                <input class="form-range" type="range" min="1" max="5" name="review[rating]" id="rating">
            </div> -->

            <div class="mb-3">
                <fieldset class="starability-basic">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                        aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
            </div>

            <div class="mb-3">
                <label class="form-label" for="body">Review</label>
                <textarea name="review[body]" class="form-control" id="body" cols="30" rows="3" required></textarea>
                <div class="valid-feedback">
                    Looks good!
                </div>
            </div>
            <button class="btn btn-success">add review</button>
        </form>

        <% } %>

        <%for(let review of coffeebar.reviews) {%>
        <div class="card">
            <div class="mb-4 card-body">
                <h5 class="card-title"> <%=review.author.username%></h5>
                <p class="starability-result" data-rating="<%=review.rating%>">
                    Rated: <%=review.rating%> stars
                </p>
                <!-- <p class="card-subtitle mb-2 text-muted"></p> -->
                <p class="card-text">Review: <%=review.body%></p>
                <% if(currentUser && review.author.equals(currentUser._id)) {%>
                <form action="/coffeebars/<%=coffeebar._id %>/reviews/<%=review._id %>?_method=delete" method="POST">
                    <button class="btn btn-sm btn-danger">Delete</button>
                </form>
                <%} %>
            </div>
        </div>
        <%}%>
            </div>
        </div>

     <script>
        const mapToken = '<%-process.env.MAPBOX_TOKEN%>';
        const coffeebar = <%- JSON.stringify(coffeebar) %>;
    </script>

        <script src="/javascripts/showPageMap.js"></script>